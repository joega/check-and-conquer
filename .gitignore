# Godot editor/import state
.godot/

# Local Godot user-data overrides used by headless tests
.godot-test-data/

# Build artifacts
builds/
build/

# Source-asset archives are recorded in assets/THIRD_PARTY_ASSETS.md, not committed.
assets/source-archives/

# The platform-specific Stockfish executable is supplied locally and staged by
# the exporter. Keep its GPL source and notices versioned, but do not put the
# 103 MB binary in ordinary Git history.
third_party/stockfish/**/stockfish-linux-x86-64-universal
third_party/stockfish/**/stockfish-windows-x86-64-universal.exe

# Local and CI Stockfish source builds, including the downloaded NNUE network.
third_party/stockfish/**/src/*.o
third_party/stockfish/**/src/.build_*
third_party/stockfish/**/src/.depend
third_party/stockfish/**/src/stockfish
third_party/stockfish/**/src/*.nnue
