[gd_resource type="Resource" script_class="CampaignCinematicSequence" load_steps=4 format=3]

[ext_resource type="Script" path="res://scripts/presentation/campaign_cinematic_sequence.gd" id="1_sequence"]
[ext_resource type="Script" path="res://scripts/presentation/campaign_cinematic_cue.gd" id="2_cue"]

[sub_resource type="Resource" id="CueGatekeeper"]
script = ExtResource("2_cue")
cue_id = "mountain.victory_gatekeeper"
title = "THE FIRST OATH"
speaker_label = "Gatekeeper"
speaker_id = "gatekeeper"
body = "Then carry our watch beyond these walls."
hold_s = 5.5
shot_position = Vector3(12, 8, 16)
shot_target = Vector3(0, 0, 0)
shot_duration_s = 0.5

[sub_resource type="Resource" id="CueGrandmaster"]
script = ExtResource("2_cue")
cue_id = "mountain.victory_grandmaster"
title = "FORTRESS SECURED"
speaker_label = "Grandmaster"
speaker_id = "grandmaster"
body = "The first oath is kept. Above the peaks, the Cloud Road waits."
hold_s = 5.2
shot_position = Vector3(8, 5.7, 10)
shot_target = Vector3(19, 3.2, 0)

[resource]
script = ExtResource("1_sequence")
sequence_id = "mountain_fortress.victory"
arena_id = "mountain_fortress"
outcome = "victory"
cues = [SubResource("CueGatekeeper"), SubResource("CueGrandmaster")]
