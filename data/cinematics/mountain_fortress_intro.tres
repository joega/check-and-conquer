[gd_resource type="Resource" script_class="CampaignCinematicSequence" load_steps=6 format=3]

[ext_resource type="Script" path="res://scripts/presentation/campaign_cinematic_sequence.gd" id="1_sequence"]
[ext_resource type="Script" path="res://scripts/presentation/campaign_cinematic_cue.gd" id="2_cue"]

[sub_resource type="Resource" id="CueOpening"]
script = ExtResource("2_cue")
cue_id = "mountain.opening"
title = "I · THE FIRST GATE"
speaker_label = "Grandmaster"
speaker_id = "grandmaster"
body = "For years, the First Gate has opened for no one."
hold_s = 4.0
shot_position = Vector3(8, 5.7, 10)
shot_target = Vector3(19, 3.2, 0)
stage_action = "seating_and_approach"

[sub_resource type="Resource" id="CueGatekeeper"]
script = ExtResource("2_cue")
cue_id = "mountain.gatekeeper"
title = "THE GATEKEEPER"
speaker_label = "Gatekeeper"
speaker_id = "gatekeeper"
body = "I kept the danger out. Tell me—who will protect the road?"
hold_s = 4.3
shot_position = Vector3(-12, 8, 16)
shot_target = Vector3(7, 2, -3)
shot_duration_s = 0.6

[sub_resource type="Resource" id="CueCommander"]
script = ExtResource("2_cue")
cue_id = "mountain.commander"
title = "THE COMMANDER"
speaker_label = "Commander"
speaker_id = "commander"
body = "We will. Open the gate."
hold_s = 3.8
shot_position = Vector3(-12, 8, 16)
shot_target = Vector3(7, 2, -3)

[sub_resource type="Resource" id="CueObjective"]
script = ExtResource("2_cue")
cue_id = "mountain.objective"
title = "OBJECTIVE"
speaker_label = "Grandmaster"
speaker_id = "grandmaster"
body = "Defeat the Gatekeeper. Reopen the First Gate."
hold_s = 1.25
shot_position = Vector3(8, 5.7, 10)
shot_target = Vector3(19, 3.2, 0)
stage_action = "return"
after_action = "formation_restore"

[resource]
script = ExtResource("1_sequence")
sequence_id = "mountain_fortress.intro"
arena_id = "mountain_fortress"
outcome = "intro"
final_hold_s = 1.95
cues = [SubResource("CueOpening"), SubResource("CueGatekeeper"), SubResource("CueCommander"), SubResource("CueObjective")]
